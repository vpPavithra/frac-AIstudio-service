{
  "name": "frac-studio-service",
  "version": "0.1.0",
  "description": "FRAC Studio: AI-assisted FRAC Creator and Reviewer backend for Aastrika Sphere",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --loader ts-node/esm src/server.ts",
    "dev:mock": "AI_PROVIDER=mock node --loader ts-node/esm src/server.ts",
    "dev:mock:seed": "AI_PROVIDER=mock FRAC_STUDIO_STORE=memory MOCK_SEED=true node --loader ts-node/esm src/server.ts",
    "dev:ai": "AI_REQUIRE_REAL=true node --loader ts-node/esm src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:mock": "AI_PROVIDER=mock node dist/server.js",
    "start:ai": "AI_REQUIRE_REAL=true node dist/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "fixtures:sample": "TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm tools/fixtures/make-sample-fixtures.ts",
    "lint": "eslint 'src/**/*.ts' 'tools/**/*.ts'",
    "format": "prettier --write 'src/**/*.{ts,json}'",
    "clean": "rm -rf dist",
    "migrate": "node --loader ts-node/esm src/migrate.ts",
    "config:check": "node --loader ts-node/esm tools/ops/check-config.ts",
    "ai:check": "node --loader ts-node/esm tools/ops/ai-check.ts",
    "ai:report": "node --loader ts-node/esm tools/reports/run-ai-report.ts",
    "ai:report:daily": "node --loader ts-node/esm tools/reports/run-ai-report.ts --daily",
    "ai:report:run": "node --loader ts-node/esm tools/reports/run-ai-report.ts --run",
    "review:report": "node --loader ts-node/esm tools/reports/run-review-report.ts",
    "check": "npm run typecheck && npm run lint && npm run config:check && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@google/genai": "2.30.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.6.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
