{
  "_comment": "Review engine r3 rule tables (FRAC_Reviewer_rules_r3.md sections 4.3, 4.4 and 5). Clinical reviewers edit this file; no code change needed. Patterns are JavaScript regular expressions. The review fingerprint includes these tables, so a changed rule never reuses a stored review. The ASHA 'instead' texts are not in the rules file and need clinical confirmation.",
  "scope": {
    "anm": [
      {
        "id": "iv",
        "act": "IV drug administration",
        "pattern": "(?<!(annexure|stage|grade|class|phase|schedule|level|module|part|chapter|type)\\s)\\b(IV|I\\.V\\.)(?![-\\w])|intravenous",
        "flags": "i",
        "allow": "refer\\w*[^.;]{0,60}(access|line|cannula)|(access|line|cannula)[^.;]{0,60}refer",
        "sev": "B",
        "instead": "Under the SBA guidelines, start an IV line only to stabilise before referral (verify against the current module and state orders)"
      },
      {
        "id": "complications",
        "act": "Managing complications or complicated deliveries",
        "pattern": "manag\\w*\\s+(the\\s+|of\\s+)?(obstetric\\s+|labou?r\\s+|delivery\\s+|medication\\s+)?(complications|emergencies)|complicated\\s+(deliver|labou?r|cases)\\w*|high[- ]risk\\s+(or|and|\\/)\\s+complicated",
        "flags": "i",
        "sev": "B",
        "instead": "Identify complications, give the specified pre-referral care (e.g. oxytocin, MgSO4 loading dose, first-dose antibiotics, bimanual compression) and refer; definitive management is at the FRU"
      },
      {
        "id": "curative",
        "act": "Curative management",
        "pattern": "curative",
        "flags": "i",
        "sev": "B",
        "instead": "Screen, counsel, support adherence, dispense MO-prescribed refills, refer"
      },
      {
        "id": "debridement",
        "act": "Wound debridement",
        "pattern": "debrid\\w*",
        "flags": "i",
        "sev": "B",
        "instead": "First aid and aseptic dressing of minor wounds, recognise infection, refer"
      },
      {
        "id": "severe",
        "act": "Independent management of severe cases",
        "pattern": "independent(ly)?\\s+manag\\w*\\s+(of\\s+)?(severe|complex|major|serious)",
        "flags": "i",
        "sev": "B",
        "instead": "Stabilise and refer"
      },
      {
        "id": "resuscitation",
        "act": "Advanced resuscitation",
        "pattern": "advanced\\s+(resuscitation|life support)|intubat\\w*",
        "flags": "i",
        "sev": "B",
        "instead": "Basic newborn resuscitation (NSSK / Helping Babies Breathe), then refer"
      },
      {
        "id": "emergency-drugs",
        "act": "Unspecified emergency drugs",
        "pattern": "emergency\\s+(meds|medicines|medications|drugs)",
        "flags": "i",
        "sev": "B",
        "instead": "Name only the drugs listed for ANM/SBA pre-referral use (verify the list)"
      },
      {
        "id": "prescribing",
        "act": "Prescribing",
        "pattern": "\\bprescrib(es|ing)\\b",
        "flags": "i",
        "sev": "B",
        "instead": "Dispense per protocol or MO prescription"
      },
      {
        "id": "operative",
        "act": "Operative or MTP procedures",
        "pattern": "\\b(MVA|manual vacuum aspiration|dilatation and curettage|caesarean|c-section|vacuum extraction|forceps deliver\\w*)\\b",
        "flags": "i",
        "sev": "B",
        "instead": "These are MO or specialist procedures"
      },
      {
        "id": "spraying",
        "act": "Insecticide spraying or larviciding",
        "pattern": "\\bspray(ing|s)?\\b|larvicid\\w*|fogging",
        "flags": "i",
        "sev": "M",
        "instead": "RDT testing, treatment per NCVBDC drug policy, LLIN promotion, support for source reduction"
      }
    ],
    "asha": [
      {
        "id": "injections",
        "act": "Giving injections",
        "pattern": "\\binject(s|ion|ions|ing)?\\b|\\bIM\\b|\\bIV\\b|intravenous",
        "flags": "i",
        "allow": "refer\\w*|motivat\\w*|mobili[sz]\\w*|accompan\\w*",
        "sev": "B",
        "instead": "Motivate and accompany the person to the ANM or facility for the injection (verify)"
      },
      {
        "id": "deliveries",
        "act": "Conducting deliveries",
        "pattern": "conduct\\w*\\s+(normal\\s+|home\\s+)?deliver\\w*",
        "flags": "i",
        "sev": "B",
        "instead": "Birth preparedness, escort to the facility for institutional delivery, HBNC visits (verify)"
      },
      {
        "id": "prescribing",
        "act": "Prescribing",
        "pattern": "\\bprescrib(es|ing)\\b",
        "flags": "i",
        "sev": "B",
        "instead": "Give drugs from the ASHA kit as per protocol, refer (verify)"
      }
    ]
  },
  "ladder": [
    {
      "id": "independent-early",
      "levels": [
        1,
        2
      ],
      "pattern": "\\bindependent(ly)?\\b|\\bwithout supervision\\b",
      "flags": "i",
      "message": "L1–L2 already say the worker acts independently",
      "frontlineOnly": false
    },
    {
      "id": "supervising-l3",
      "levels": [
        3
