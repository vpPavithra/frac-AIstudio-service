# Pre-build image for the Jenkins "docker-pre-build" stage: installs all deps, compiles TypeScript and
# zips dist/, config/, migrations/ and the package files into /usr/src/app/dist.zip.
# Jenkins copies dist.zip out and unzips it before build.sh builds the runtime Dockerfile.
FROM node:20
WORKDIR /usr/src/app

COPY . .

RUN apt update && apt install -y zip

# Compile, then package only what the runtime image needs
RUN npm ci && npm run build && zip -r dist.zip dist config migrations package.json package-lock.json
