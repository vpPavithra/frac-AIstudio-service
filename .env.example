# Secrets and per-deployment values only. Every other setting (models, rates, limits, timeouts,
# CORS) lives in config/service.json, which is committed and reviewed; any key there can still be
# overridden here. Never put a secret in service.json: startup refuses it.

NODE_ENV=development

# Secrets
# Claude API key. Set it and the AI steps use Claude; leave it empty and they use the sample-data
# mock in src/mocks. Locally it goes here in .env (gitignored); on a server, in the deployment's
# secret store as the ANTHROPIC_API_KEY environment variable. Never in config/service.json.
ANTHROPIC_API_KEY=
POSTGRES_PASSWORD=

# Shared AI Studio / AskMe Postgres on aastrika_net
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=

# Local development
# PORT=3010                    # orgportal's dev proxy sends /apis/protected/v8/fracStudio here
# FRAC_STUDIO_STORE=memory     # run without Postgres (data lost on restart)
# MIGRATE_ON_START=true        # apply pending migrations at startup

# AI (see src/mocks/README.md)
# AI_PROVIDER=auto             # auto: Claude if ANTHROPIC_API_KEY is set, else the mock; claude / mock force one
# MOCK_DELAY_MS=1500           # mock only: pause per call so progress is visible
# MOCK_SEED=true               # mock + memory store only: one finished FRAC + review per owner at startup
# MOCK_SEED_OWNERS=local-dev-user
