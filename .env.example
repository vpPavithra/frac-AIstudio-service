# Secrets and per-deployment values only. Every other setting (models, rates, limits, timeouts,
# CORS) lives in config/service.json, which is committed and reviewed; any key there can still be
# overridden here. Never put a secret in service.json: startup refuses it.

NODE_ENV=development

# Secrets
# AI keys. AI_PROVIDER (config/service.json, default claude) picks a profile in
# config/ai-providers.json, and the profile names which key it reads. Only the key for the provider in
# use is needed; `npm run dev:mock` needs none. Locally they go here in .env (gitignored); on a server, in
# the deployment's secret store under the same names. Never in a config/ file: startup refuses them.
ANTHROPIC_API_KEY=
POSTGRES_PASSWORD=
# Shared with the uiproxy (its FRAC_STUDIO_SERVICE_KEY): every /v1 request must carry it in x-service-key.
# Required when NODE_ENV=production; leave empty for local runs without the proxy. Generate: openssl rand -hex 32
SERVICE_KEY=

# Shared AI Studio / AskMe Postgres on the shared Docker network
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
# TLS: set true for any database not on the same host. Keep certificate checks on (true) unless the server uses a
# self-signed certificate you trust.
# POSTGRES_SSL=true
# POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# Local development
# PORT=3010                    # orgportal's dev proxy sends /apis/protected/v8/fracStudio here
# FRAC_STUDIO_STORE=memory     # run without Postgres (data lost on restart)
# MIGRATE_ON_START=true        # apply pending migrations at startup

# AI (see src/mocks/README.md)
# AI_PROVIDER=claude           # mock | claude | claude-mixed | claude-fast (profiles in config/ai-providers.json)
# MOCK_DELAY_MS=1500           # mock only: pause per call so progress is visible
# MOCK_SEED=true               # mock + memory store only: one finished FRAC + review per owner at startup
# MOCK_SEED_OWNERS=local-dev-user
