NODE_ENV=development
PORT=3005
# "memory" runs without Postgres (data lost on restart); anything else uses the POSTGRES_* settings
FRAC_STUDIO_STORE=
# Optional overrides for the runtime config files
OUTDATED_CONFIG_PATH=
METHOD_PARAGRAPH_PATH=

# Shared AI Studio / AskMe Postgres on aastrika_net
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

# LLM (spec section 9). Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_COMPLEX_MODEL=claude-opus-5-5
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5-5
